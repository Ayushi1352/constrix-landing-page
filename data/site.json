      "Faq": {
        "variants": {
          "ConstrixFaq1": {
            "label": "FAQs",
            "titleTop": "Frequently Asked",
            "titleAccent": "Questions",
            "description": "Quick answers to common questions about our construction process, cost estimates, timelines, approvals and warranties.",
            "help": {
              "title": "Still have questions?",
              "text": "Our team is happy to talk through your project and guide you with the best solution.",
              "button": {
                "label": "Get a Quote",
                "href": "#contact"
              }
            },
            "items": [
              {
                "question": "What types of construction projects does Constrix handle?",
                "answer": "Constrix handles residential homes and villas, commercial towers and office complexes, industrial factories and warehouses, as well as civil infrastructure projects such as roads and bridges. We also offer full renovation and architectural planning services."
              },
              {
                "question": "How do I get a cost estimate for my project?",
                "answer": "Fill in the quote form below or contact our team directly. Once we understand your requirements, built-up area and location, we provide a detailed, itemized Bill of Quantities (BOQ) with transparent pricing."
              },
              {
                "question": "Do you assist with building permits and approvals?",
                "answer": "Yes. Our team prepares architectural drawings, submits municipal sanctions and coordinates approvals to ensure full compliance with the National Building Code (NBC) and local bylaws."
              },
              {
                "question": "What is the typical timeline for a residential home?",
                "answer": "A standard residential project typically takes 8 to 14 months depending on total area, design complexity and finish selections. We provide a milestone-based project schedule before construction starts."
              },
              {
                "question": "What payment structure do you follow?",
                "answer": "We follow a milestone-based payment schedule tied to actual progress on site — foundation, slab casting per level, masonry, MEP works and final finishes. You only pay as each stage is completed and verified."
              },
              {
                "question": "What warranty do you offer after completion?",
                "answer": "We provide a 10-year structural warranty on core concrete and RCC frameworks, along with a 12-month Defect Liability Period covering plumbing, electrical works and waterproofing after handover."
              }
            ]
          }
        }
      },
